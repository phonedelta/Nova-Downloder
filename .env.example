PORT=3001
HOST=127.0.0.1
# Browser-reachable API origin used in signed downloadUrl (never Docker hostnames)
# On Railway: https://TON-SERVICE.up.railway.app
NOVA_PUBLIC_DOWNLOAD_BASE_URL=http://127.0.0.1:3001
# Max simultaneous media streams (default 4)
MAX_CONCURRENT_DOWNLOADS=4
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
TRANSLATE_URL=
TRANSLATE_API_KEY=
# CORS_ORIGINS=https://novadownloader.example
# Long random secret for signed download tokens (required in production)
# DOWNLOAD_SIGNING_SECRET=
# YT_DLP_COOKIES=/path/to/cookies.txt
# YT_DLP_EXTRACTOR_ARGS=youtube:player_client=mweb,tv,android,ios
# YT_DLP_DOWNLOAD_EXTRACTOR_ARGS=youtube:player_client=mweb,tv
# PO Token server (required for HD qualities on Railway / datacenter IPs)
YT_DLP_POT_BASE_URL=http://127.0.0.1:4416
# YT_DLP_POT_DISABLE=1
