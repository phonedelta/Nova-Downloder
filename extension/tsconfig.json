{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["chrome", "vite/client"],
    "paths": {
      "@nova/shared": ["../packages/shared/src/index.ts"]
    },
    "baseUrl": "."
  },
  "include": ["src", "../packages/shared/src"]
}
